{
  "info": {
    "name": "IF133 P6 - API Quality dan JWT",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Pengujian nyata CRUD, validasi, ProblemDetails, JWT Admin/Reader dan CORS. Isi password melalui environment lokal, jangan ekspor token/password. Jalankan berurutan; hanya produk buatan runner yang dihapus."
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{adminToken}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://localhost:7216"
    },
    {
      "key": "adminUsername",
      "value": "admin"
    },
    {
      "key": "readerUsername",
      "value": "reader"
    },
    {
      "key": "adminPassword",
      "value": ""
    },
    {
      "key": "readerPassword",
      "value": ""
    },
    {
      "key": "adminToken",
      "value": ""
    },
    {
      "key": "readerToken",
      "value": ""
    },
    {
      "key": "productId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "01 Tanpa token ditolak",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/products",
        "auth": {
          "type": "noauth"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 401\",()=>pm.response.to.have.status(401));",
              "pm.test(\"ProblemDetails dan traceId\",()=>{const b=pm.response.json();pm.expect(b.status).to.eql(pm.response.code);pm.expect(b.title).to.be.a(\"string\");pm.expect(b.traceId).to.be.a(\"string\");});"
            ]
          }
        }
      ]
    },
